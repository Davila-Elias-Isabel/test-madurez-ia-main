# Variables de Entorno — Test de Madurez IA (ENIA 2026-2030)
# Copia este archivo a .env.local y rellena los valores

# Anthropic API — Claude IA para generador de planes y chat flotante
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_KEY_2=your_anthropic_api_key_2_here

# Supabase — Base de datos para planes de acción y glosario
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase — Cliente (usado en componentes de frontend si es necesario)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
